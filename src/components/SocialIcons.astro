---
import OldSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const links = [
  {
    url: 'https://forth.ink',
    label: 'Forthink',
    title: 'Indie Works'
  },
  {
    url: 'https://blog.evecalm.com/',
    label: 'Blog'
  },
  {
    url: 'https://app.evecalm.com/',
    label: 'Works',
    title: 'Opensource Works'
  }
]
---
<OldSocialIcons />
{links.map(({ label, url, title }) => (
  <a href={url} rel="me noopener noreferrer" class="sl-flex fg-link" title={title || ''} target="_blank">
    {label}
  </a>
))}
